{
  "name": "web-pak",
  "private": true,
  "version": "0.1.0",
  "description": "pakket in the browser: compress, extract, encrypt, browse, preview, edit and convert archives in 50+ formats, entirely on your device.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/vendor-7z.mjs && vite build && node scripts/stamp.mjs",
    "check-build": "node scripts/stamp.mjs --check",
    "preview": "vite preview --port 5194 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node tests/e2e.mjs",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "7z-wasm": "1.2.0",
    "@bokuweb/zstd-wasm": "0.0.27",
    "age-encryption": "0.3.1",
    "brotli-wasm": "3.0.1",
    "hash-wasm": "4.13.0",
    "lz4js": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
