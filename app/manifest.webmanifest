{
  "name": "web-pak",
  "short_name": "web-pak",
  "description": "Compress, extract, encrypt, browse and convert archives on your own device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#16181d",
  "theme_color": "#16181d",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": {
      "application/zip": [".zip", ".zipx", ".jar", ".apk", ".epub", ".cbz"],
      "application/x-7z-compressed": [".7z"],
      "application/vnd.rar": [".rar", ".cbr"],
      "application/x-tar": [".tar", ".tgz", ".tbz2", ".txz"],
      "application/gzip": [".gz"], "application/x-bzip2": [".bz2"], "application/x-xz": [".xz"], "application/zstd": [".zst"],
      "application/x-iso9660-image": [".iso"], "application/x-apple-diskimage": [".dmg"],
      "application/vnd.ms-cab-compressed": [".cab"], "application/octet-stream": [".age", ".lz4", ".br", ".wim", ".001"]
    } }
  ],
  "share_target": {
    "action": "./share", "method": "POST", "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "files", "accept": ["*/*"] }] }
  }
}
